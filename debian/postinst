#!/bin/sh
set -e

# postinst: ensure markitdown is available + auto-fix dependencies

# Auto-install missing dependencies (run once after dpkg install)
apt-get install -f -y >/dev/null 2>&1 || true

PYTHON=$(which python3)
PACKAGE="markitdown"
LOG="/var/log/anyfile-to-markdown-install.log"

echo "[anyfile-to-markdown] postinst started at $(date)" >> "$LOG" 2>&1

echo "[anyfile-to-markdown] Checking $PACKAGE availability..." >> "$LOG"
$PYTHON -m pip install "$PACKAGE" --upgrade --ignore-installed --break-system-packages >> "$LOG" 2>&1 || true

echo "[anyfile-to-markdown] Running compatibility test..." >> "$LOG"
TEST_RESULT=$($PYTHON -c "
from markitdown import MarkItDown
print('OK')
" 2>> "$LOG" || true)

case "$TEST_RESULT" in
    OK)
        echo "[anyfile-to-markdown] markitdown OK" >> "$LOG"
        ;;
    *)
        echo "[anyfile-to-markdown] markitdown FAILED to import" >> "$LOG"
        ;;
esac

gtk-update-icon-cache /usr/share/icons/hicolor/ 2>/dev/null || true
kbuildsycoca7 --noincremental 2>/dev/null || kbuildsycoca6 --noincremental 2>/dev/null || true

echo "[anyfile-to-markdown] postinst finished at $(date)" >> "$LOG"
exit 0
