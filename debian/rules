#!/usr/bin/make -f

export PYBUILD_NAME=anyfile-to-markdown

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/anyfile-to-markdown/usr/bin
	install -m 755 debian/anyfile-to-markdown-launcher debian/anyfile-to-markdown/usr/bin/anyfile-to-markdown
	mkdir -p debian/anyfile-to-markdown/usr/share/applications
	install -m 644 debian/anyfile-to-markdown.desktop debian/anyfile-to-markdown/usr/share/applications/
	mkdir -p debian/anyfile-to-markdown/usr/share/icons/hicolor/scalable/apps
	install -m 644 icons/hicolor/scalable/apps/anyfile-to-markdown.svg debian/anyfile-to-markdown/usr/share/icons/hicolor/scalable/apps/
	mkdir -p debian/anyfile-to-markdown/usr/share/icons/hicolor/48x48/apps
	install -m 644 icons/hicolor/48x48/apps/anyfile-to-markdown.png debian/anyfile-to-markdown/usr/share/icons/hicolor/48x48/apps/
	mkdir -p debian/anyfile-to-markdown/usr/share/icons/hicolor/256x256/apps
	install -m 644 icons/hicolor/256x256/apps/anyfile-to-markdown.png debian/anyfile-to-markdown/usr/share/icons/hicolor/256x256/apps/
